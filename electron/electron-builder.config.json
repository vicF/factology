{
    "appId": "com.factology.desktop",
    "productName": "Factology",
    "directories": {
        "buildResources": "resources"
    },
    "files": [
        "app/**/*",
        "src/**/*",
        "assets/**/*"
    ],
    "win": {
        "target": "nsis",
        "icon": "assets/appIcon.ico"
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true
    },
    "mac": {
        "target": "dmg",
        "category": "public.app-category.productivity"
    }
}